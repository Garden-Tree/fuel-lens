# FuelLens の環境変数。`cp .env.example .env.local` でコピーして値を設定します。
# 一覧は docs/setup.md「環境変数」、/api/analyze 関連は docs/api-analyze.md、
# keepalive (CRON_SECRET / SUPABASE_SERVICE_ROLE_KEY) は docs/operations.md を参照してください。

# Gemini API (AI解析用、サーバー専用)
GEMINI_API_KEY=

# 使用するGeminiモデル (任意。未設定時は gemini-3.5-flash-lite が使われます)
GEMINI_MODEL=

# 主モデルが 503 などで一時的に失敗し続けたときの代替モデル (任意。未設定時は gemini-2.5-flash)
# 空文字 (GEMINI_FALLBACK_MODEL=) にすると代替しません。値を入れるか、この行ごと消して既定を使ってください
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# 未ログインのお試し読み取り (/api/analyze) の Cookie 署名鍵 (任意。サーバー専用)
# 設定すると、未ログインでも端末 (ブラウザ) ごとに3回まで AI 読み取りを試せます (IP ごとに1日10回の上限つき)。
# 未設定ならお試しは無効で、未ログインの AI 読み取りは従来どおり 401 (ログイン必須) です。
# openssl rand -base64 32 などで生成したランダムな長い文字列を設定します。変えると発行済みの Cookie は無効 (回数が数え直し) になります。
# 絶対に NEXT_PUBLIC_ を付けないでください。公開ページの文言も切り替わるので、変更後は再デプロイしてください。
TRIAL_COOKIE_SECRET=

# アプリの公開URL (任意。例: https://fuel-lens.example.com)
# /api/analyze の Origin チェックで、リクエストの Host に加えてこのURLのホストも許可します。
# リバースプロキシやカスタムドメイン経由で Host ヘッダーが実際の公開ホストと異なる場合に設定してください。
NEXT_PUBLIC_APP_URL=

# Clerk (認証用)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase に渡す Clerk トークンの取得方法 (任意)
# 開発インスタンス (ローカル・Vercel Preview) では JWT テンプレート名 `supabase` を設定します。
# 本番インスタンスでは空のままにします (ネイティブ Third-Party Auth。getToken() を引数なしで呼びます)。
NEXT_PUBLIC_CLERK_SUPABASE_JWT_TEMPLATE=

# Supabase (データベース用)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Cron → /api/keepalive の認証用シークレット (本番では必須。Supabase 自動停止対策)
# openssl rand -hex 32 などで生成したランダムな長い文字列を設定します。
CRON_SECRET=

# Supabase の service_role キー (任意。/api/keepalive で件数取得まで行う場合に設定)
# サーバー専用です。絶対に NEXT_PUBLIC_ を付けないでください (ブラウザに露出します)。
SUPABASE_SERVICE_ROLE_KEY=

# 開発ビルドでも Service Worker（Web Share Target の受け取り）を登録するなら 1。本番ビルドでは常に登録される
NEXT_PUBLIC_ENABLE_SW=

# Sentry (エラー監視。すべて任意。手順は docs/operations.md「Sentry」)
# DSN (Sentry のプロジェクト Settings → Client Keys (DSN))。クライアントとサーバーの両方で使うので NEXT_PUBLIC_ が付きます。
# 未設定なら Sentry は完全に無効になります (何も送らず、コンソールにも出しません)。
NEXT_PUBLIC_SENTRY_DSN=
# ソースマップのアップロード用 (ビルド時のみ。未設定でもビルドは通ります)。組織スラッグ・プロジェクトスラッグ・
# 認証トークン (Organization Settings → Auth Tokens で作成)。SENTRY_AUTH_TOKEN はサーバー専用で秘密です。
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google Play (Trusted Web Activity) の Digital Asset Links (任意。手順は docs/play-store/README.md)
# /.well-known/assetlinks.json に載せるアプリ署名鍵の SHA-256 フィンガープリント (パッケージ名は com.gadelog.fuellens 固定)。
# 例: 14:6D:E9:...:E5。カンマ区切りで複数指定できます (アップロード鍵と Play アプリ署名鍵の両方を入れる場合など)。
# 未設定のときは /.well-known/assetlinks.json が 404 を返します。秘密ではありませんが、鍵ごとに違うのでリポジトリには書きません。
ANDROID_ASSETLINKS_SHA256=
