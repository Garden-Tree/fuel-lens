# Gemini API (AI OCR用)
GEMINI_API_KEY=

# 使用するGeminiモデル (任意。未設定時は gemini-3.1-flash-lite が使われます)
GEMINI_MODEL=

# AI解析 (/api/analyze) を未ログインでも許可するか (任意。既定は false = ログイン必須)
# true にするとIPごとに3回までのお試し解析を許可します。カウンタはサーバーインスタンスの
# メモリ上にあるベストエフォートな制限で、サーバーレス環境では確実ではありません。
# 開発・デモ用途以外では有効にしないでください。
ALLOW_ANONYMOUS_SCAN=

# アプリの公開URL (任意。例: https://fuel-lens.example.com)
# /api/analyze の Origin チェックで、リクエストの Host に加えてこのURLのホストも許可します。
# リバースプロキシやカスタムドメイン経由で Host ヘッダーが実際の公開ホストと異なる場合に設定してください。
NEXT_PUBLIC_APP_URL=

# Clerk (認証用)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (データベース用)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Cron → /api/keepalive の認証用シークレット (本番では必須。Supabase 自動停止対策)
# openssl rand -hex 32 などで生成したランダムな長い文字列を設定します。
CRON_SECRET=

# Supabase の service_role キー (任意。/api/keepalive で件数取得まで行う場合に設定)
# サーバー専用です。絶対に NEXT_PUBLIC_ を付けないでください (ブラウザに露出します)。
SUPABASE_SERVICE_ROLE_KEY=
